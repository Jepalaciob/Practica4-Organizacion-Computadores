/*********
* Main.jack - Punto de entrada del juego. Solo crea el juego, lo ejecuta y
* lo libera: ninguna otra clase puede llamar a Main, porque las pruebas
* reemplazan este archivo.
* Autor 1: Thomas Serna Saldarriaga
* Autor 2: Juan Esteban Palacio Betancur
*********/
class Main {
    /** Crea el juego, lo ejecuta hasta que el jugador sale con ESC y lo libera. */
    function void main() {
        var Juego juego;
        let juego = Juego.new();
        do juego.ejecutar();
        do juego.dispose();
        return;
    }
}
