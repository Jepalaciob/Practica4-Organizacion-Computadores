/*********
* TipoObstaculo.jack - Configuracion de datos para cada tipo de obstaculo.
* Permite especializar obstaculos por composicion sin usar herencia.
* Autor: Thomas Serna Saldarriaga
*********/
class TipoObstaculo {
    field int tipo;
    field int largo;
    field int velocidad;
    field boolean letal;
    field int puntos;

    /** Crea la configuracion de un tipo de obstaculo. */
    constructor TipoObstaculo new(int idTipo, int unLargo, int unaVel, boolean esLetal, int unosPuntos) {
        let tipo = idTipo;
        let largo = unLargo;
        let velocidad = unaVel;
        let letal = esLetal;
        let puntos = unosPuntos;
        return this;
    }

    /** Codigo del tipo: 0 cono, 1 camion, 2 moto, 3 moneda. */
    method int tipo() {
        return tipo;
    }

    /** Cantidad de celdas horizontales que ocupa. */
    method int largo() {
        return largo;
    }

    /** Celdas que avanza hacia la izquierda en cada paso. */
    method int velocidad() {
        return velocidad;
    }

    /** Indica si al chocar quita una vida al jugador. */
    method boolean esLetal() {
        return letal;
    }

    /** Puntos que otorga al tocar el carro. */
    method int puntos() {
        return puntos;
    }

    /** Primer paso (contando desde el proximo avanzar) en que un obstaculo de
        este tipo con su celda izquierda en col toca la columna 2 del carro:
        el primero en que su columna nueva queda en 2 o menos. */
    method int pasoLlegada(int col) {
        return ((col - 2) + (velocidad - 1)) / velocidad;
    }

    /** Ultimo paso en que todavia toca la columna 2 del carro: el ultimo en
        que su celda derecha, antes de moverse, sigue en la columna 2 o mas. */
    method int pasoSalida(int col) {
        return ((col + largo - 3) / velocidad) + 1;
    }

    /** Libera la configuracion de memoria. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
